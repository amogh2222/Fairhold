# ==============================================================================
# FAIRHOLD ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and configure with your credentials.
# NEVER commit real secret values to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PayPal Developer Sandbox
# Get credentials at: https://developer.paypal.com/dashboard/applications/sandbox
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

# ------------------------------------------------------------------------------
# 2. Database Connection (Postgres via Prisma)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/fairhold?schema=public

# ------------------------------------------------------------------------------
# 3. Authentication & Security
# ------------------------------------------------------------------------------
AUTH_SECRET=fairhold_super_secret_jwt_encryption_key_change_in_production
APP_BASE_URL=http://localhost:3000
ADMIN_PASSCODE=fairhold2026

# ------------------------------------------------------------------------------
# 4. AI Models (Vercel AI SDK)
# Providers: "google" (default) or "anthropic"
# Model IDs must never be hardcoded in code.
# ------------------------------------------------------------------------------
LLM_PROVIDER=google
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL_VISION=gemini-2.0-flash
LLM_MODEL_TEXT=gemini-2.0-flash

# For Anthropic Claude:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-api03-...
# LLM_MODEL_VISION=claude-3-5-sonnet-20241022
# LLM_MODEL_TEXT=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 5. S3-Compatible Object Storage (Cloudflare R2, Supabase, or AWS S3)
# ------------------------------------------------------------------------------
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=fairhold-inspections
S3_ACCESS_KEY_ID=your_s3_access_key
S3_SECRET_ACCESS_KEY=your_s3_secret_key
S3_REGION=auto

# ------------------------------------------------------------------------------
# 6. Sponsor Prize Integrations
# ------------------------------------------------------------------------------
# AG Grid Studio License Key
AG_STUDIO_LICENSE_KEY=your_ag_studio_trial_license_key

# Channel3 Replacement Price Lookup API Key (https://trychannel3.com)
CHANNEL3_API_KEY=your_channel3_api_key

# Resend Email (Optional: If omitted, links are displayed in UI and logged)
RESEND_API_KEY=
